SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_PATH=data/db.sqlite3
LEXIKON_DB_PATH=data/lexikon.sqlite3
ASTRO_DB_PATH=data/astro.sqlite3

# Astro-Modul: kostenloser Account unter https://www.geonames.org/login,
# danach unter "Manage Account" die Web-Services freischalten.
GEONAMES_USERNAME=

# Nur fuer Produktion/Docker relevant - lokal mit DEBUG=True nicht noetig.
CSRF_TRUSTED_ORIGINS=
MEDIA_ROOT=media

# Optional: legt beim ersten Start automatisch einen Admin-Account an, falls
# noch keiner existiert (siehe apps/accounts/management/commands/create_admin.py).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# System-Mails der App (aktuell nur "Passwort vergessen") - eigenes
# "system@"-Postfach unter der Shop-Domain, getrennt vom normalen
# Geschaeftspostfach. Kundenmails (Rundmails o.ae.) sind NICHT Teil dieser
# Konfiguration (dafuer fehlt aktuell die DSGVO-Einwilligung der Etsy-Kunden).
# Ohne EMAIL_HOST faellt lokal (DEBUG=True) automatisch auf die Konsole
# zurueck (Mail landet im Server-Log statt im Postfach).
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Wonderland ERP <system@wonderland-diorama.de>
